# The public URL of the site: canonical links, the sitemap and Open Graph URLs.
# Read at build time (pages are prerendered), so set it before `pnpm bundle`.
SITE_URL=https://jj.livesoftwaredeveloper.com

# The Jupiter Jots backend that stores shares and comments (no trailing slash).
# NEXT_PUBLIC_JJ_API_URL is read AT BUILD TIME and inlined into the browser bundle, which
# uses it for comments, votes and live updates, so set it before `pnpm build` / `pnpm bundle`.
# A production build without it does not fail, but every share page shows
# "This share can't be loaded" and the server logs one warning. In development it
# defaults to http://127.0.0.1:8000.
NEXT_PUBLIC_JJ_API_URL=https://api.example.com

# Optional, read at runtime by the server only: the URL server renders use to fetch a
# share, e.g. a private address on the same host. Defaults to NEXT_PUBLIC_JJ_API_URL.
# JJ_API_URL=http://127.0.0.1:8000

# Optional, read AT BUILD TIME (inlined into the browser bundle): the Chrome extension id of
# Jupiter Jots, so a share page's "Save to Jupiter Jots" button can hand the share to the
# installed extension. The store build's id is dnfmgdmobmoglemckapnbgncnfhkighd; for an
# unpacked dev build use the id shown on chrome://extensions. Unset: the button only shows
# how to install the extension and import the link by hand.
# NEXT_PUBLIC_JJ_EXTENSION_ID=dnfmgdmobmoglemckapnbgncnfhkighd
